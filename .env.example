# SAKAN (سَكَن) Environment Configuration Template
# Copy this file to .env.local and fill in your actual Supabase project credentials.

# 1. Supabase Public Settings (Required for client and server queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Supabase Server-Only Secret (Required for privileged administrative operations)
# NEVER expose this key in client bundles or public repositories.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application URL (Used for auth redirects and canonical metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Feature Flags & Optional Integrations
# Enable when an SMS provider (e.g. Twilio or MessageBird via Supabase Auth) is provisioned
NEXT_PUBLIC_ENABLE_SMS_AUTH=false

# Enable when Web Push Service Worker and VAPID keys are configured
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
